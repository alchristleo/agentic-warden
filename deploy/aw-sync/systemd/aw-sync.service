[Unit]
Description=Sync agent governance files from the agent-wrapper control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aw-sync once
# systemd creates the state directory world-readable, so any user can run
# `aw-sync status`; the machine credential inside it, machine.json, is 0600.
StateDirectory=agent-wrapper
StateDirectoryMode=0755
